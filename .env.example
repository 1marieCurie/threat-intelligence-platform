LOG_LEVEL=INFO
CISA_NORMALIZATION_BATCH_SIZE=100
CISA_NORMALIZATION_LEASE_TIMEOUT_SECONDS=900
CISA_NORMALIZATION_MAX_ATTEMPTS=3

DOCUMENTATION_DATABASE_URL=postgresql+psycopg://threat_intel_reader:CHANGE_ME@localhost:5432/threat_intelligence

# Machine inventory API
# JSON array containing SHA-256 hashes only.
# Never commit raw machine API keys.
TIP_MACHINE_CREDENTIALS_JSON=[]

# Asset Inventory runtime database.
# Use a local secret in .env; never commit the real password.
ASSET_DATABASE_URL=postgresql+psycopg://threat_intel_asset_api:CHANGE_ME@localhost:5432/threat_intelligence

# Machine credentials.
# Only SHA-256 API-key digests are stored server-side.
TIP_MACHINE_CREDENTIALS_JSON=[]

# Notification delivery backend.
#
# disabled:
#   alerts remain persisted but no external delivery is performed.
#
# gmail:
#   real Gmail API delivery is enabled and all required
#   TIP_GMAIL_* credentials below must be configured.
TIP_NOTIFICATION_BACKEND=disabled

# Gmail alert notifications
#
# OAuth scope required:
# https://www.googleapis.com/auth/gmail.send
#
# Never commit real OAuth credentials or refresh tokens.
TIP_GMAIL_CLIENT_ID=CHANGE_ME
TIP_GMAIL_CLIENT_SECRET=CHANGE_ME
TIP_GMAIL_REFRESH_TOKEN=CHANGE_ME
TIP_GMAIL_SENDER_EMAIL=CHANGE_ME
TIP_GMAIL_SENDER_NAME=Threat Intelligence Platform
TIP_GMAIL_TIMEOUT_SECONDS=10

# Manual Gmail E2E / final PFA demo.
# These values are not secrets, but keep real OAuth values only in .env.
TIP_GMAIL_E2E_ORGANIZATION_SLUG=CHANGE_ME
TIP_DEMO_ORGANIZATION_SLUG=CHANGE_ME
TIP_DEMO_CVE_ID=CVE-2021-44228

# Local development users only.
# Never commit real passwords.
TIP_DEV_STAFF_PASSWORD=CHANGE_ME
TIP_DEV_SECURITY_PASSWORD=CHANGE_ME