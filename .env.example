LOG_LEVEL=INFO
CISA_NORMALIZATION_BATCH_SIZE=100
CISA_NORMALIZATION_LEASE_TIMEOUT_SECONDS=900
CISA_NORMALIZATION_MAX_ATTEMPTS=3

DOCUMENTATION_DATABASE_URL=postgresql+psycopg://threat_intel_reader:CHANGE_ME@localhost:5432/threat_intelligence

# Machine inventory API
# JSON array containing SHA-256 hashes only.
# Never commit raw machine API keys.
TIP_MACHINE_CREDENTIALS_JSON=[]

# Asset Inventory runtime database.
# Use a local secret in .env; never commit the real password.
ASSET_DATABASE_URL=postgresql+psycopg://threat_intel_asset_api:CHANGE_ME@localhost:5432/threat_intelligence

# Machine credentials.
# Only SHA-256 API-key digests are stored server-side.
TIP_MACHINE_CREDENTIALS_JSON=[]